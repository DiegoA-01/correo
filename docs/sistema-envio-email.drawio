<mxfile host="app.diagrams.net">
  <diagram id="envio-email" name="Sistema de Envío de Email">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="827">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SISTEMA DE ENVÍO DE EMAIL" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="500" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="React (Netlify) → Spring Boot (Render) → Cloudflare Worker → SendGrid → Destinatario · sin base de datos" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="z1" value="Frontend · Netlify" style="swimlane;startSize=30;fillColor=#e6f9fe;strokeColor=#05BDBA;fontColor=#057F7D;fontStyle=1;rounded=1;arcSize=6;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="240" as="geometry"/></mxCell>
        <mxCell id="react" value="&lt;b&gt;React&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Formulario de envío&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="z1"><mxGeometry x="60" y="45" width="80" height="71" as="geometry"/></mxCell>
        <mxCell id="netlify" value="&lt;font style=&quot;font-size:10px&quot;&gt;Hosting estático&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=data:image/svg+xml,;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;" vertex="1" parent="z1"><mxGeometry x="45" y="190" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="z2" value="Backend · Render" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#6DB33F;fontColor=#3D7A1F;fontStyle=1;rounded=1;arcSize=6;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="200" height="240" as="geometry"/></mxCell>
        <mxCell id="spring" value="&lt;b&gt;Spring Boot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/email · valida&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="z2"><mxGeometry x="64" y="45" width="72" height="72" as="geometry"/></mxCell>
        <mxCell id="render" value="&lt;font style=&quot;font-size:10px&quot;&gt;Docker · plan gratis duerme&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=data:image/svg+xml,;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=4;" vertex="1" parent="z2"><mxGeometry x="30" y="190" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="z3" value="Serverless · Cloudflare" style="swimlane;startSize=30;fillColor=#fef3e8;strokeColor=#F38020;fontColor=#C25E0B;fontStyle=1;rounded=1;arcSize=6;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="200" height="240" as="geometry"/></mxCell>
        <mxCell id="worker" value="&lt;b&gt;Cloudflare Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Verifica X-Internal-Key&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="z3"><mxGeometry x="60" y="50" width="80" height="64" as="geometry"/></mxCell>
        <mxCell id="z4" value="Servicio externo" style="swimlane;startSize=30;fillColor=#fff9e6;strokeColor=#1A82E2;fontColor=#1A82E2;fontStyle=1;rounded=1;arcSize=6;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="200" height="240" as="geometry"/></mxCell>
        <mxCell id="resend" value="&lt;b&gt;SendGrid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;API v3 /mail/send&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=https://app.diagrams.net/img/lib/azure2/integration/SendGrid_Accounts.svg;" vertex="1" parent="z4"><mxGeometry x="68" y="50" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;Destinatario&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="165" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" value="1. POST JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=default;" edge="1" parent="1" source="react" target="spring"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. POST + clave" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=default;" edge="1" parent="1" source="spring" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. API Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=default;" edge="1" parent="1" source="worker" target="resend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="4. Email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="resend" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Flujo&lt;/b&gt;&lt;br&gt;1. El usuario llena el formulario en React (Netlify), que envía un POST a Spring Boot (Render) en /api/email.&lt;br&gt;2. Spring Boot valida los datos y llama al Cloudflare Worker con el header secreto X-Internal-Key (solo el backend puede usar el Worker).&lt;br&gt;3. El Worker (serverless) llama a la API v3 de SendGrid con la API Key guardada como secreto en Cloudflare.&lt;br&gt;4. SendGrid entrega el correo al destinatario (línea punteada = fuera de nuestro sistema).&lt;br&gt;&lt;i&gt;Sin base de datos: no se guarda historial de envíos.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1090" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
